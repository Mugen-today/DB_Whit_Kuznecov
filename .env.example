# Generate a private .env with: python scripts/manage.py init
# This template contains no usable credentials. Do not copy it over a generated .env.
MONGO_ROOT_USER=storage_admin
MONGO_ROOT_PASSWORD=
INGEST_PASSWORD=
PROCESSOR_PASSWORD=
READER_PASSWORD=
USER_PASSWORD=
GUEST_PASSWORD=
MONGO_PORT=27017
# init generates unique names; Compose creates these volumes automatically.
STORAGE_DATA_VOLUME=
STORAGE_CONFIG_VOLUME=
