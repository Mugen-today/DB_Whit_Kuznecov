# Normalize text files in the repository
* text=auto

# Source code and configuration
*.py text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.conf text eol=lf
*.txt text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
*.dockerignore text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf
.env.example text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.zip binary
*.xlsx binary

# Keep bundled JSON bytes stable for SHA256 verification on every OS.
/data/testB_normalized.json binary
